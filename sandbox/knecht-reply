#!/usr/bin/env bash
# Post a reply on the session's ticket, issue or pull request, as Knecht.
# Only available when the session belongs to one (KNECHT_OBJECT is set); the
# Knecht host posts the comment through the integration
# (server/routes/agent-bridge.post.ts). See sandbox/opencode/AGENTS.md.
set -euo pipefail

LIB=/usr/local/lib/knecht-bridge-lib
[ -f "$LIB" ] || { echo "knecht-reply is not available: bridge lib not mounted" >&2; exit 1; }
. "$LIB"

usage() {
  cat <<'EOF'
usage:
  knecht-reply <text>     post a comment on this session's ticket/issue/PR
  echo <text> | knecht-reply    same, reading the text from stdin
  knecht-reply --new-thread <text>    start a new comment instead of
                                      answering in the mention's thread
EOF
  exit 2
}

require_bridge knecht-reply

new_thread=false
if [ "${1:-}" = "--new-thread" ]; then
  new_thread=true
  shift
fi

if [ "$#" -gt 0 ]; then
  text="$*"
else
  text="$(cat)"
fi
[ -n "$text" ] || usage

bridge_post "{\"op\":\"comment\",\"newThread\":$new_thread,\"body\":$(json_escape "$text")}"
