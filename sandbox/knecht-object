#!/usr/bin/env bash
# Print the current state of the session's ticket, issue or pull request, or
# with a key of another one in the same project, fetched live by the Knecht host
# (server/routes/agent-bridge.post.ts). See sandbox/opencode/AGENTS.md.
set -euo pipefail

LIB=/usr/local/lib/knecht-bridge-lib
[ -f "$LIB" ] || { echo "knecht-object is not available: bridge lib not mounted" >&2; exit 1; }
. "$LIB"

require_bridge knecht-object

if [ $# -gt 0 ]; then
  bridge_post "{\"op\":\"context\",\"key\":$(json_escape "$1")}"
else
  bridge_post '{"op":"context"}'
fi
