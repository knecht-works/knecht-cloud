#!/usr/bin/env bash
# Add or remove labels on the session's ticket, issue or pull request. On
# GitHub only labels that already exist in the repo can be added (Knecht never
# invents labels); the Knecht host applies them through the integration
# (server/routes/agent-bridge.post.ts). See sandbox/opencode/AGENTS.md.
set -euo pipefail

LIB=/usr/local/lib/knecht-bridge-lib
[ -f "$LIB" ] || { echo "knecht-label is not available: bridge lib not mounted" >&2; exit 1; }
. "$LIB"

usage() {
  cat <<'EOF'
usage:
  knecht-label add <name> [<name> ...]      add labels to this session's ticket/issue/PR
  knecht-label remove <name> [<name> ...]   remove labels from it
EOF
  exit 2
}

require_bridge knecht-label

action="${1:-}"
shift || true
[ "$#" -gt 0 ] || usage
case "$action" in
  add) key="add" ;;
  remove) key="remove" ;;
  *) usage ;;
esac

# JSON array of the label names (node is in the image for the js step).
labels="$(node -e 'console.log(JSON.stringify(process.argv.slice(1)))' "$@")"

bridge_post "{\"op\":\"label\",\"$key\":$labels}"
