#!/usr/bin/env node
// Forward TCP connections from every container interface to a port on
// localhost. A dev server started with its defaults (Vite, Nuxt, Next) binds
// 127.0.0.1 only, which the preview proxy cannot reach from outside the
// container; this runs under supervisord next to the dev server (daemon/
// ddev.ts) and is what the proxy targets instead. A connection while the
// dev server is down is closed right away, so a health poll keeps polling.
// Plain CommonJS on purpose: it runs from /usr/local/bin under any Node the
// project pins.
const net = require('node:net')
const tls = require('node:tls')

const [listenPort, targetPort] = process.argv.slice(2).map(Number)
if (!listenPort || !targetPort) {
  console.error('usage: knecht-forward <listen-port> <target-port>')
  process.exit(2)
}

// A dev server started with https (mkcert, basic-ssl) only speaks TLS while
// Knecht speaks plain http, so the forwarder wraps the upstream side when needed.
const HANDSHAKE_TIMEOUT_MS = 1000
let mode = 'unknown'

function connect(secure) {
  return new Promise((resolve) => {
    const socket = secure
      ? tls.connect({ port: targetPort, host: '127.0.0.1', rejectUnauthorized: false })
      : net.connect(targetPort, '127.0.0.1')
    // A plain server may wait for a header end that a TLS hello never sends.
    socket.setTimeout(HANDSHAKE_TIMEOUT_MS, () => socket.destroy(new Error('handshake timeout')))
    socket.once(secure ? 'secureConnect' : 'connect', () => {
      socket.setTimeout(0)
      resolve({ socket })
    })
    socket.once('error', (error) => {
      socket.destroy()
      resolve({ error })
    })
  })
}

async function connectUpstream() {
  if (mode !== 'plain') {
    const { socket, error } = await connect(true)
    if (socket) {
      mode = 'tls'
      return socket
    }
    if (error.code === 'ECONNREFUSED') return null
  }
  const { socket } = await connect(false)
  if (socket) mode = 'plain'
  return socket ?? null
}

net.createServer(async (client) => {
  client.on('error', () => client.destroy())
  const upstream = await connectUpstream()
  if (!upstream || client.destroyed) {
    client.destroy()
    upstream?.destroy()
    return
  }
  let answered = false
  const drop = () => {
    // A TLS-only server closes a plain request without a byte: detect again next time.
    if (!answered && mode === 'plain' && client.bytesRead > 0) mode = 'unknown'
    client.destroy()
    upstream.destroy()
  }
  client.on('error', drop)
  upstream.on('error', drop)
  client.on('close', drop)
  upstream.on('close', drop)
  client.pipe(upstream).pipe(client)
  upstream.on('data', () => {
    answered = true
  })
}).listen(listenPort, '0.0.0.0')
